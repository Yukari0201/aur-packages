{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)PKGBUILD$/"],
      "matchStrings": [
        "(?:pkgver|_pkgver)=(?<currentValue>.*) # renovate: datasource=(?<datasource>.*) depName=(?<depName>.*)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)PKGBUILD$/"],
      "matchStrings": [
        "(?:_pkgver_stable|_pkgver_testing)=(?<currentValue>[^#\\s]+) # renovate: datasource=(?<datasource>.*) depName=(?<depName>.*)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["reF1nd/sing-box-releases"],
      "matchCurrentValue": "/^v?\\d+\\.\\d+\\.\\d+-reF1nd(?:\\.\\d+)?$/",
      "groupName": "sing-box reF1nd stable",
      "ignoreUnstable": true,
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-reF1nd(?:\\.(?<build>\\d+))?$"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["reF1nd/sing-box-releases"],
      "matchCurrentValue": "/^v?\\d+\\.\\d+\\.\\d+-(?:alpha|beta|rc)\\.\\d+-reF1nd(?:\\.\\d+)?$/",
      "groupName": "sing-box reF1nd testing",
      "ignoreUnstable": false,
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<prerelease>(?:alpha|beta|rc)\\.\\d+)-reF1nd(?:\\.(?<revision>\\d+))?$"
    }
  ]
}
